# Vermeidet, dass lokale node_modules / data / .git in den Docker-Build wandern.
# Nixpacks ignoriert .dockerignore normalerweise, aber sobald du in Dokploy
# auf "Use Dockerfile" umschaltest, zählt es.

node_modules
npm-debug.log
.env
.env.*
data
*.db
*.db-journal
.git
.gitignore
.github
.vscode
.idea
.DS_Store
*.log
coverage
.nyc_output
README-DEPLOY.md
.github
.claude
