# ============================================================
#  gebetszeiten-weltweit — Umgebungsvariablen
#  Kopieren nach .env und Werte eintragen. NIEMALS einchecken!
# ============================================================

# --- Appwrite (Datenbank-Cache + eigene Städte) --------------
# API-Key aus Appwrite → Project Settings → API Keys
# Scopes: databases.read, databases.write, collections.*.read
APPWRITE_ENDPOINT=https://appwrite.chargedesk.de/v1
APPWRITE_PROJECT=6a20bfcd000e9e4ca544
APPWRITE_KEY=
APPWRITE_DB_ID=igmg
APPWRITE_PRAYERS_COLL=prayer_times_data
APPWRITE_CITIES_COLL=custom_cities

# --- IGMG offizielle App Server API (igmgapp.org) -----------
# Optional: ohne Key wird automatisch die IGMG-AJAX-Quelle genutzt.
IGMG_APP_BASE_URL=https://igmgapp.org:8081
IGMG_API_KEY=

# --- App ----------------------------------------------------
PORT=3000
NODE_ENV=production
DATA_DIR=/app/data
# Pflicht für die Key-Verwaltung (/api/keys); leer = gesperrt. Erzeugen: openssl rand -hex 24
ADMIN_TOKEN=
